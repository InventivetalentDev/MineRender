# TypeDoc 0.28.20 misses source links in Git worktrees because their .git entry is a file.
# This workaround is only needed for worktree builds; ordinary checkouts work without it.
# Remove it and its package.json/yarn.lock references once TypeDoc supports .git files
# upstream, or if documentation no longer needs to build in worktrees.

diff --git a/dist/index.js b/dist/index.js
index daa82424664dcf1236746613e27a3e79abf96bdd..2edf4d36e3f24f3fa10444690a541e18f647ac1d 100644
--- a/dist/index.js
+++ b/dist/index.js
@@ -9777,7 +9777,7 @@ var RepositoryManager = class {
         checkedDirs.add(dir);
         try {
           const gitStats = await stat(join2(dir, ".git"));
-          return gitStats.isDirectory();
+          return gitStats.isDirectory() || gitStats.isFile();
         } catch {
           return false;
         }
