{
  "name": "minerender",
  "version": "2.1.0-beta.1",
  "description": "Interactive 3D renders of Minecraft skins, models, blocks, entities and worlds",
  "main": "./dist/node/index.js",
  "module": "./dist/browser/index.mjs",
  "browser": "./dist/browser/index.mjs",
  "types": "./dist/browser/index.d.ts",
  "unpkg": "./dist/bundle.js",
  "jsdelivr": "./dist/bundle.js",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/browser/index.d.mts",
          "default": "./dist/browser/index.mjs"
        },
        "require": {
          "types": "./dist/browser/index.d.ts",
          "default": "./dist/browser/index.js"
        }
      },
      "node": {
        "import": {
          "types": "./dist/node/index.d.mts",
          "default": "./dist/node/index.mjs"
        },
        "require": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        }
      },
      "default": {
        "import": {
          "types": "./dist/browser/index.d.mts",
          "default": "./dist/browser/index.mjs"
        },
        "require": {
          "types": "./dist/browser/index.d.ts",
          "default": "./dist/browser/index.js"
        }
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser/index.d.mts",
        "default": "./dist/browser/index.mjs"
      },
      "require": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/node/index.mjs"
      },
      "require": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    },
    "./bundle": "./dist/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist docs",
    "build": "rm -rf dist && tsup",
    "build:watch": "tsup --watch",
    "exports": "bash ./scripts/make-exports.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "ava",
    "test:package": "ava --config ava.package.config.js",
    "doc": "yarn doc:generate && vitepress build reference",
    "doc:generate": "typedoc",
    "doc:dev": "yarn doc:generate && vitepress dev reference",
    "doc:preview": "vitepress preview reference",
    "prepublishOnly": "yarn run build",
    "publish:alpha": "yarn build && yarn version prerelease --immediate && yarn npm publish --tag alpha",
    "publish:beta": "yarn build && yarn version prerelease --immediate && yarn npm publish --tag beta"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Haylee Schäfer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InventivetalentDev/MineRender.git",
    "directory": "packages/minerender"
  },
  "homepage": "https://minerender.org",
  "peerDependencies": {
    "three": "^0.186.1"
  },
  "optionalDependencies": {
    "canvas": "^2.6.1"
  },
  "dependencies": {
    "@inventivetalent/loading-cache": "^1.0.0",
    "@inventivetalent/time": "^1.0.4",
    "@zip.js/zip.js": "^2.7.31",
    "buffer": "^6.0.3",
    "crypto-js": "^4.0.0",
    "fast-png": "^8.0.0",
    "image-size": "^0.9.4",
    "jobqu": "^3.1.0",
    "localforage": "^1.9.0",
    "node-persist": "^3.1.0",
    "postprocessing": "^6.39.5",
    "prismarine-nbt": "^2.2.1",
    "stats.js": "^0.17.0",
    "ts-deepmerge": "2.0.2"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.0.1",
    "@types/node": "^20.17.6",
    "@types/node-persist": "^3.1.1",
    "@types/three": "~0.186.0",
    "ava": "^5.3.1",
    "esbuild": "^0.19.5",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "esbuild-runner": "^2.2.2",
    "three": "^0.186.1",
    "tsup": "^8.5.0",
    "typedoc": "patch:typedoc@npm%3A0.28.20#~/.yarn/patches/typedoc-npm-0.28.20-92d0a89709.patch",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~5.6.3",
    "vitepress": "^1.6.4"
  }
}
