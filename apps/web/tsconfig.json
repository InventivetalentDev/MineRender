{
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "moduleResolution": "Node",
    "module": "ES6",
    "target": "ES2020",
    "esModuleInterop": true,
    "lib": [
      "es2020",
      "dom",
      "dom.iterable"
    ]
  },
  "include": ["src"],
  "exclude": [
    "node_modules"
  ]
}
