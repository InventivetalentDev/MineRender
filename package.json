{
  "name": "minerender-monorepo",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "yarn build:lib && yarn build:consumers && yarn workspace @minerender/api build",
    "build:lib": "yarn workspace minerender build",
    "build:api": "yarn build:lib && yarn workspace @minerender/api build",
    "start:api": "yarn workspace @minerender/api start",
    "build:consumers": "yarn workspace @minerender/web build && yarn workspace @minerender/example-vite build && yarn workspace @minerender/example-script-tag build && yarn workspace @minerender/site build",
    "build:site": "yarn build:lib && yarn workspace @minerender/site build",
    "deploy:site": "yarn build:lib && yarn workspace @minerender/site deploy",
    "deploy:site:preview": "yarn build:lib && yarn workspace @minerender/site deploy:preview",
    "build:watch": "yarn workspace minerender build:watch",
    "typecheck": "yarn workspace minerender typecheck && yarn workspace @minerender/web typecheck && yarn workspace @minerender/web typecheck:editor && yarn workspace @minerender/example-vite typecheck && yarn workspace @minerender/api typecheck",
    "test": "yarn workspace minerender test",
    "test:package": "yarn workspace minerender test:package",
    "test:node": "yarn workspace minerender test:node",
    "test:api": "yarn workspace @minerender/api test",
    "test:api:native": "yarn workspace @minerender/api test:native",
    "exports": "yarn workspace minerender exports",
    "doc": "yarn workspace minerender doc",
    "doc:dev": "yarn workspace minerender doc:dev",
    "doc:preview": "yarn workspace minerender doc:preview",
    "deploy:docs": "yarn workspace minerender doc:deploy",
    "deploy:docs:preview": "yarn workspace minerender doc:deploy:preview",
    "clean": "yarn workspace minerender clean",
    "dev:web": "yarn build:lib && yarn workspace @minerender/web dev",
    "dev:vite": "yarn build:lib && yarn workspace @minerender/example-vite dev",
    "dev:script-tag": "yarn build:lib && yarn workspace @minerender/example-script-tag dev",
    "dev:site": "yarn build:lib && yarn workspace @minerender/site dev",
    "publish:alpha": "yarn workspace minerender publish:alpha",
    "publish:beta": "yarn workspace minerender publish:beta",
    "build:web": "yarn build:lib && yarn workspace @minerender/web build:production",
    "deploy:web": "yarn build:lib && yarn workspace @minerender/web deploy",
    "preview:web": "yarn build:lib && yarn workspace @minerender/web preview:cf"
  }
}
